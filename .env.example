# Copie para .env e preencha. O .env fica fora do git.
AGENTE_DATABASE_URL=sqlite:///agente.db
AGENTE_MODO=sombra
AGENTE_POLITICA_PATH=politica.toml
AGENTE_LOG_LEVEL=INFO

# Chatwoot (T3)
AGENTE_CHATWOOT_URL=
AGENTE_CHATWOOT_CONTA=
AGENTE_CHATWOOT_INBOX=
AGENTE_CHATWOOT_TOKEN=
AGENTE_CHATWOOT_TIME_HUMANO=
AGENTE_WEBHOOK_SEGREDO=

# Webhooks de pagamento (T1, T9). Sem o segredo (ou vazio), o webhook responde 503.
AGENTE_PIX_WEBHOOK_SEGREDO=
AGENTE_CTN_WEBHOOK_SEGREDO=

# LLM que redige (T6). Sem a chave, o serviço usa o redator falso.
AGENTE_GROQ_API_KEY=
AGENTE_GROQ_MODELO=openai/gpt-oss-120b
