# Copie para .env e preencha. O .env fica fora do git.
AGENTE_DATABASE_URL=sqlite:///agente.db
AGENTE_POLITICA_PATH=politica.toml
AGENTE_LOG_LEVEL=INFO

# Chatwoot (T3)
AGENTE_CHATWOOT_URL=
AGENTE_CHATWOOT_CONTA=
AGENTE_CHATWOOT_INBOX=
AGENTE_CHATWOOT_TOKEN=
AGENTE_CHATWOOT_TIME_HUMANO=
AGENTE_WEBHOOK_SEGREDO=

# Webhooks de pagamento (T1, T9). Sem o segredo (ou vazio), o webhook responde 503.
AGENTE_PIX_WEBHOOK_SEGREDO=
AGENTE_CTN_WEBHOOK_SEGREDO=

# O Luna do turno (D42, D59): o gpt-6-luna da OpenAI. Sem a chave, o serviço não sobe.
# AGENTE_LLM_CORPO_EXTRA (JSON) entra no corpo de todo pedido; o Luna recusa a temperatura (HTTP 400)
# sem o reasoning_effort "none". Para outro provedor compatível, mude a URL, o modelo e o corpo extra.
AGENTE_LLM_API_KEY=
AGENTE_LLM_URL=https://api.openai.com/v1
AGENTE_LLM_MODELO=gpt-6-luna
AGENTE_LLM_CORPO_EXTRA={"reasoning_effort": "none"}

# Liberação do Luna real com o CTN real (M2). Com o AGENTE_CTN_API_KEY e o AGENTE_LLM_API_KEY juntas, o serviço
# só sobe com esta em true, e ela só vale depois que a retenção de dados da OpenAI for conferida (T6, D42).
AGENTE_LLM_DADOS_REAIS_LIBERADOS=false

# CTN real, pela API EFICAZ (T9, só leitura; o link, o Pix e a baixa seguem falsos). Sem a chave, o serviço
# usa o CTN falso. A chave nunca vai para o git, o log nem o chat.
AGENTE_CTN_API_KEY=
AGENTE_CTN_URL=https://api.eficaz-group.com
AGENTE_CTN_UNIDADE=jp

# Transcrição do áudio do cliente (D43, T11): o gpt-4o-mini-transcribe, com variáveis próprias. Sem a
# URL e a chave, a transcrição fica desligada e o áudio cai no pedido de texto; só uma das duas é erro.
AGENTE_TRANSCRICAO_URL=
AGENTE_TRANSCRICAO_API_KEY=
# AGENTE_TRANSCRICAO_MODELO=gpt-4o-mini-transcribe  # o padrão; sozinho, sem a URL e a chave, é erro
