# Copie para .env e preencha. O .env fica fora do git.
AGENTE_DATABASE_URL=sqlite:///agente.db
AGENTE_MODO=sombra
AGENTE_POLITICA_PATH=politica.toml
AGENTE_LOG_LEVEL=INFO

# Chatwoot (T3)
AGENTE_CHATWOOT_URL=
AGENTE_CHATWOOT_CONTA=
AGENTE_CHATWOOT_INBOX=
AGENTE_CHATWOOT_TOKEN=
AGENTE_CHATWOOT_TIME_HUMANO=
AGENTE_WEBHOOK_SEGREDO=

# Webhooks de pagamento (T1, T9). Sem o segredo (ou vazio), o webhook responde 503.
AGENTE_PIX_WEBHOOK_SEGREDO=
AGENTE_CTN_WEBHOOK_SEGREDO=

# LLM que redige (D42, T6): o gpt-6-luna da OpenAI. Sem a chave, o serviço usa o redator falso.
# AGENTE_LLM_CORPO_EXTRA (JSON) entra no corpo de todo pedido; o Luna recusa a temperatura (HTTP 400)
# sem o reasoning_effort "none". Para outro provedor compatível, mude a URL, o modelo e o corpo extra.
AGENTE_LLM_API_KEY=
AGENTE_LLM_URL=https://api.openai.com/v1
AGENTE_LLM_MODELO=gpt-6-luna
AGENTE_LLM_CORPO_EXTRA={"reasoning_effort": "none"}

# Webchat (7.1 a 7.4). Sem AGENTE_WEBCHAT_SEGREDO, AGENTE_WEBCHAT_IDENTIDADE_HMAC ou
# AGENTE_WEBCHAT_WEBSITE_TOKEN (ou vazios), a página /atendimento responde 503.
# O segredo do token precisa de ao menos 32 caracteres.
AGENTE_WEBCHAT_SEGREDO=
AGENTE_WEBCHAT_IDENTIDADE_HMAC=
AGENTE_WEBCHAT_WEBSITE_TOKEN=
AGENTE_WEBCHAT_INBOX=
AGENTE_WEBCHAT_URL_BASE=
