# Copie para /opt/agente-inadimplencia/agente.env, preencha e deixe fora do git (chmod 600).
# O compose lê este arquivo no serviço `agente`. A chave do CTN e o segredo do webhook do Pix
# ficam de fora de propósito: o CTN é o falso e o Pix é o de teste (as pontas de pagamento seguem
# paradas até T1 e T9).

# O banco do compose: o host é `postgres`; usuário, senha e banco são os do `.env` do compose.
AGENTE_DATABASE_URL=postgresql+psycopg://agente:trocar-isto@postgres:5432/agente
# Onde o compose monta a política de teste e o cardápio (não mude).
AGENTE_POLITICA_PATH=/etc/agente/politica.toml
AGENTE_LOG_LEVEL=INFO

# Chatwoot de teste (conta 91). O serviço não sobe sem URL, conta e token.
AGENTE_CHATWOOT_URL=trocar-isto
AGENTE_CHATWOOT_CONTA=
AGENTE_CHATWOOT_INBOX=280
# Token do Agent Bot (o novo, depois da rotação).
AGENTE_CHATWOOT_TOKEN=trocar-isto
# O time que recebe o handoff para o atendente.
AGENTE_CHATWOOT_TIME_HUMANO=
# O segredo que vai na URL do webhook: /webhooks/chatwoot/<segredo>. Gere um longo e aleatório.
AGENTE_WEBHOOK_SEGREDO=trocar-isto

# O Luna do turno. Sem a chave, o serviço não sobe.
AGENTE_LLM_API_KEY=trocar-isto
# Com o Chatwoot real e a OpenAI juntos, o serviço só sobe com true, e só depois de conferida a
# retenção de dados da OpenAI (T6, D42).
AGENTE_LLM_DADOS_REAIS_LIBERADOS=false
